<?xml version="1.0" encoding="UTF-8"?>
<messages>
  <!-- dgxs- is short for DetectorGeometryCrossSection: the tooltip text of the cross-section
       drawing beside the detector geometry form.  Keep the English in sync with the fallback
       table in DetectorGeometryCrossSection.cpp (used when there is no session). -->
  <message id="dgxs-front">front (source side)</message>
  <message id="dgxs-crystal">Active crystal volume</message>
  <message id="dgxs-dead">Dead layer (inactive crystal)</message>
  <message id="dgxs-bore">Bore hole (void)</message>
  <message id="dgxs-layer">Layer {1}: {2}</message>
  <message id="dgxs-collimator">Collimator: {1}</message>
  <message id="dgxs-material">{1} ({2} g/cm³)</message>
  <message id="dgxs-dims-cyl">Diameter {1}, length {2}</message>
  <message id="dgxs-dims-box">{1} × {2} × {3} (width × height × length)</message>
  <message id="dgxs-fillet">Front edge fillet radius {1}</message>
  <message id="dgxs-bore-dims">Diameter {1}, depth {2} from the back{3}</message>
  <message id="dgxs-bore-rounded"> (rounded tip)</message>
  <message id="dgxs-dead-dims">Front {1}, side {2}</message>
  <message id="dgxs-dead-dims-back">Front {1}, side {2}, back {3}</message>
  <message id="dgxs-layer-dims">Front {1}, side {2}; outer diameter {3}</message>
  <message id="dgxs-coll-dims">Thickness {1}, extends {2} past the face; inner diameter {3}</message>
  <message id="dgxs-volume">Volume: {1} cm³</message>
  <message id="dgxs-mass">Mass: {1}</message>
  <message id="dgxs-void">(empty)</message>
  <!-- A layer left blank on the geometry form: it is a real gap, named for the tooltip. -->
  <message id="dgxs-vacuum">vacuum</message>
</messages>
