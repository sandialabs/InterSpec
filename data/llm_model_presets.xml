<?xml version="1.0" encoding="UTF-8"?>
<!-- Provider presets and model defaults for the "LLM Provider Settings" window of the LLM Assistant.

     To customize, copy this file to your OS provided data directory for InterSpec (the same location
     llm_config.xml is saved to - see "Help" > "About InterSpec" > "Data" for the actual location);
     a copy there is used instead of this one.

     Nothing in this file is used while the assistant runs - it only pre-fills fields in the settings
     window, which the user can then change, and which are then saved to llm_config.xml.
-->
<LlmModelPresets version="1">

  <!-- Well-known providers, shown in the drop-down to the right of the "API endpoint" field.
       Choosing one sets the provider's endpoint (and clears any wire-format/transport override).
       Optional attributes:
         apiFormat   - "openai_chat", "openai_responses", or "anthropic"; omit to auto-detect from
                       the URL (which works for all of the endpoints below).
         httpBackend - "native" for providers whose CORS policy blocks requests made from the
                       browser engine (only used in builds that have a native HTTP client).
       <SuggestedModel> is filled in if the provider does not have any model named yet.
  -->
  <ProviderPresets>
    <Preset label="OpenAI (Chat Completions)">
      <ApiEndpoint>https://api.openai.com/v1/chat/completions</ApiEndpoint>
      <SuggestedModel>gpt-5-mini</SuggestedModel>
    </Preset>
    <!-- OpenAI's newer API.  Chat Completions (above) works with almost every model, but some of
         OpenAI's newest models (e.g., gpt-6-astra, gpt-6.1-sol, and the -pro models) only support
         tool calling, which the assistant requires, through the Responses API. -->
    <Preset label="OpenAI (Responses, newer)">
      <ApiEndpoint>https://api.openai.com/v1/responses</ApiEndpoint>
      <SuggestedModel>gpt-5-mini</SuggestedModel>
    </Preset>
    <Preset label="Anthropic (Claude)">
      <ApiEndpoint>https://api.anthropic.com/v1/messages</ApiEndpoint>
      <SuggestedModel>claude-sonnet-5-5</SuggestedModel>
    </Preset>
    <Preset label="Google Gemini (AI Studio)">
      <ApiEndpoint>https://generativelanguage.googleapis.com/v1beta/openai/chat/completions</ApiEndpoint>
      <SuggestedModel>gemini-3.8-flash</SuggestedModel>
    </Preset>
    <!-- OpenRouter model names include the vendor, e.g. "anthropic/claude-sonnet-5.5"; use
         "Fetch models" to pick one. -->
    <Preset label="OpenRouter">
      <ApiEndpoint>https://openrouter.ai/api/v1/chat/completions</ApiEndpoint>
    </Preset>
    <Preset label="xAI (Grok)">
      <ApiEndpoint>https://api.x.ai/v1/chat/completions</ApiEndpoint>
      <SuggestedModel>grok-4.3</SuggestedModel>
    </Preset>
    <!-- Ask Sage model names are its own (e.g., "google-gemini-2.5-pro", "gpt-5.6-sol-gov"); use
         "Fetch models" to see them. -->
    <Preset label="Ask Sage (Commercial)" httpBackend="native">
      <ApiEndpoint>https://api.asksage.com/server/openai/v1/chat/completions</ApiEndpoint>
      <SuggestedModel>gpt-5-mini</SuggestedModel>
    </Preset>
    <Preset label="Ask Sage (Gov)" httpBackend="native">
      <ApiEndpoint>https://api.asksage.ai/server/openai/v1/chat/completions</ApiEndpoint>
      <SuggestedModel>gpt-5-mini</SuggestedModel>
    </Preset>
    <Preset label="Ask Sage (NNSA)" httpBackend="native">
      <ApiEndpoint>https://api.nnsa.asksage.ai/server/openai/v1/chat/completions</ApiEndpoint>
      <SuggestedModel>gpt-5-mini</SuggestedModel>
    </Preset>
    <!-- Local servers; these do not need an API key. -->
    <Preset label="Ollama (local)">
      <ApiEndpoint>http://localhost:11434/v1/chat/completions</ApiEndpoint>
      <SuggestedModel>gpt-oss:20b</SuggestedModel>
    </Preset>
    <Preset label="LM Studio (local)">
      <ApiEndpoint>http://localhost:1234/v1/chat/completions</ApiEndpoint>
      <SuggestedModel>openai/gpt-oss-20b</SuggestedModel>
    </Preset>
    <Preset label="vLLM / other local server">
      <ApiEndpoint>http://localhost:8000/v1/chat/completions</ApiEndpoint>
    </Preset>
  </ProviderPresets>


  <!-- Default settings applied when the user picks, or types, a model name.

       Each <Model> has a `match` pattern: a case-insensitive glob ('*' matches anything), tried
       against the full model name and against the part after its last '/' (so "openai/gpt-oss-120b",
       "models/gemini-2.5-flash", and OpenRouter's "anthropic/claude-sonnet-4.5" are all matched).
       The FIRST matching entry is used, so put specific patterns before general ones.

       Entries with an `endpoint` attribute (a glob on the provider's endpoint URL) instead override
       individual fields of the general entry, for providers whose limits differ (see the end of
       this file).

       Attributes (all optional; only those given are applied):
         supportsImages            - "true"/"false"
         reasoning                 - "false", "true" (on, at the model's default level), "low",
                                     "medium", or "high"
         maxTokens                 - max output tokens per response (including reasoning)
         contextLength             - the context limit to suggest; old conversation is summarized at
                                     ~85% of it
         requireToolInStateMachine - "true" for models that tend to stop making tool calls part-way
                                     through a task
         requiresFormat            - "openai_chat", "openai_responses", or "anthropic": the only wire
                                     format the model works with; not a setting, it just warns the
                                     user if the endpoint uses a different one (usually given with an
                                     `endpoint`, as other providers may translate)

       Conventions used below:
         - reasoning: "medium" for frontier/flagship models; "high" for non-frontier, flash, mini,
           and open-weight models (which benefit more from thinking longer); omitted/"false" for
           models without reasoning - turning it on for those can make the provider reject requests.
         - contextLength: at most 200000, even for models with 1M-token windows, so long
           conversations stay affordable; the model's true window is noted in comments.
         - maxTokens: 32000 to 64000 for reasoning models, so thinking does not crowd out the answer.
       For models not listed here, values reported by a provider's model listing ("Fetch models")
       are used, but capped at 64000 max tokens and a 200000 context limit (see
       LlmModelPresets::ModelDefaults::sm_maxFetchedMaxTokens / sm_maxFetchedContextLength).
       Model information as of October 2026.
  -->
  <ModelDefaults>
    <!-- ===== OpenAI ===== -->
    <!-- gpt-4o / 4o-mini: 128K window, 16K output; not reasoning models -->
    <Model match="gpt-4o*" supportsImages="true" reasoning="false" maxTokens="16384" contextLength="128000" />
    <!-- gpt-4.1 / mini / nano: 1M window, 32K output; not reasoning models -->
    <Model match="gpt-4.1*" supportsImages="true" reasoning="false" maxTokens="32768" contextLength="200000" />
    <!-- gpt-5-chat-latest / gpt-5.x-chat-latest: the ChatGPT models; 128K window, 16K output, and
         reasoning settings are not accepted -->
    <Model match="gpt-*chat*" supportsImages="true" reasoning="false" maxTokens="16384" contextLength="128000" />
    <!-- gpt-oss-120b / 20b (open weight): 131K window, text only -->
    <Model match="*gpt-oss*" supportsImages="false" reasoning="high" maxTokens="32768" contextLength="131072"
           requireToolInStateMachine="true" />
    <!-- The -pro models only accept higher effort levels (gpt-5-pro: high only); Responses API only -->
    <Model match="gpt-*-pro*" supportsImages="true" reasoning="high" maxTokens="64000" contextLength="200000" />
    <!-- Smaller tiers: gpt-5-mini/nano (400K window), gpt-5.x-mini, gpt-5.6-terra/luna, gpt-6-luna (1M) -->
    <Model match="gpt-5*mini*" supportsImages="true" reasoning="high" maxTokens="64000" contextLength="200000" />
    <Model match="gpt-5*nano*" supportsImages="true" reasoning="high" maxTokens="64000" contextLength="200000" />
    <Model match="gpt-*terra*" supportsImages="true" reasoning="high" maxTokens="64000" contextLength="200000" />
    <Model match="gpt-*luna*" supportsImages="true" reasoning="high" maxTokens="64000" contextLength="200000" />
    <!-- Flagships: gpt-5, gpt-5.x, gpt-5.6-sol, gpt-6-sol/astra, gpt-6.1-sol (400K-1M window, 128K output).
         Note: gpt-6-astra and gpt-6.1-sol only do tool calling via the Responses API. -->
    <Model match="gpt-5*" supportsImages="true" reasoning="medium" maxTokens="64000" contextLength="200000" />
    <Model match="gpt-6*" supportsImages="true" reasoning="medium" maxTokens="64000" contextLength="200000" />
    <!-- o-series: 200K window, 100K output; o3-mini is text only.  ("gpt-o3" etc are Ask Sage names) -->
    <Model match="o3-mini*" supportsImages="false" reasoning="high" maxTokens="64000" contextLength="200000" />
    <Model match="gpt-o3-mini*" supportsImages="false" reasoning="high" maxTokens="64000" contextLength="200000" />
    <Model match="o4-mini*" supportsImages="true" reasoning="high" maxTokens="64000" contextLength="200000" />
    <Model match="gpt-o4-mini*" supportsImages="true" reasoning="high" maxTokens="64000" contextLength="200000" />
    <Model match="o3*" supportsImages="true" reasoning="medium" maxTokens="64000" contextLength="200000" />
    <Model match="gpt-o3*" supportsImages="true" reasoning="medium" maxTokens="64000" contextLength="200000" />

    <!-- ===== Anthropic =====
         Max tokens is required by the Anthropic API.  Claude 5.x and Opus/Sonnet 4.6+: 1M window,
         128K output; Claude 4.5 models: 200K window, 64K output.  All accept images. -->
    <!-- Claude 3.x (mostly retired): only 3.7 Sonnet thinks; 3.5 models give at most 8K output, others 4K -->
    <Model match="*claude-3-7*" supportsImages="true" reasoning="medium" maxTokens="32000" contextLength="200000" />
    <Model match="*claude-3.7*" supportsImages="true" reasoning="medium" maxTokens="32000" contextLength="200000" />
    <Model match="*claude-3-5*" supportsImages="true" reasoning="false" maxTokens="8192" contextLength="200000" />
    <Model match="*claude-3.5*" supportsImages="true" reasoning="false" maxTokens="8192" contextLength="200000" />
    <Model match="*claude-3*" supportsImages="true" reasoning="false" maxTokens="4096" contextLength="200000" />
    <Model match="*claude*haiku*" supportsImages="true" reasoning="high" maxTokens="32000" contextLength="200000" />
    <!-- Fable, Mythos, Opus, Sonnet -->
    <Model match="*claude*" supportsImages="true" reasoning="medium" maxTokens="32000" contextLength="200000" />

    <!-- ===== Google Gemini =====
         1M window, 64K output; all accept images.  Thinking cannot be turned off on Gemini 2.5 Pro or
         Gemini 3+.  ("google-gemini-..." are Ask Sage names, and "google/gemini-..." OpenRouter/Vertex) -->
    <!-- Gemini 2.0 and 1.x do not think; 1M window, 8K output -->
    <Model match="*gemini-2.0*" supportsImages="true" reasoning="false" maxTokens="8192" contextLength="200000"
           requireToolInStateMachine="true" />
    <Model match="*gemini-1*" supportsImages="true" reasoning="false" maxTokens="8192" contextLength="200000"
           requireToolInStateMachine="true" />
    <Model match="*gemini*flash*" supportsImages="true" reasoning="high" maxTokens="32768" contextLength="200000"
           requireToolInStateMachine="true" />
    <!-- Pro / Argon flagships -->
    <Model match="*gemini*" supportsImages="true" reasoning="medium" maxTokens="32768" contextLength="200000"
           requireToolInStateMachine="true" />

    <!-- ===== xAI Grok =====
         All accept images; xAI does not publish max output.  Only some Grok models accept
         reasoning_effort - sending it to the others is an error - so those get reasoning="false"
         (most of them still reason, by themselves). -->
    <!-- grok-4.20: 1M window, does not accept reasoning_effort -->
    <Model match="grok-4.20*" supportsImages="true" reasoning="false" maxTokens="32768" contextLength="200000" />
    <!-- grok-build, grok-code-fast: coding models, no reasoning effort -->
    <Model match="grok-build*" reasoning="false" maxTokens="32768" contextLength="200000" />
    <Model match="grok-code*" reasoning="false" maxTokens="32768" contextLength="200000" />
    <!-- grok-4.3 (1M window): accepts none/low/medium/high -->
    <Model match="grok-4.3*" supportsImages="true" reasoning="high" maxTokens="32768" contextLength="200000" />
    <!-- grok-4 (grok-4-0709), and the grok-4-fast / grok-4-1-fast (non-)reasoning models: always (or
         never) reason, and reject reasoning_effort -->
    <Model match="grok-4" supportsImages="true" reasoning="false" maxTokens="32768" contextLength="200000" />
    <Model match="grok-4-0*" supportsImages="true" reasoning="false" maxTokens="32768" contextLength="200000" />
    <Model match="grok-4-latest" supportsImages="true" reasoning="false" maxTokens="32768" contextLength="200000" />
    <Model match="grok-*non-reasoning*" supportsImages="true" reasoning="false" maxTokens="32768" contextLength="200000" />
    <Model match="grok-4*fast*" supportsImages="true" reasoning="false" maxTokens="32768" contextLength="200000" />
    <!-- grok-3-mini (and -fast): accepts low/high -->
    <Model match="grok-*mini*" supportsImages="true" reasoning="high" maxTokens="32768" contextLength="200000" />
    <!-- Older non-reasoning models: grok-3, grok-3-fast, grok-2 -->
    <Model match="grok-3*" supportsImages="true" reasoning="false" maxTokens="32768" contextLength="131072" />
    <Model match="grok-2*" supportsImages="true" reasoning="false" maxTokens="32768" contextLength="131072" />
    <!-- Flagships: grok-4.5 / 4.6 / 4.7 (500K window; accept low/medium/high, but reasoning cannot be
         disabled) -->
    <Model match="grok-*" supportsImages="true" reasoning="medium" maxTokens="32768" contextLength="200000" />

    <!-- ===== Meta Llama (not reasoning models) ===== -->
    <!-- Llama 4 Scout / Maverick: 1M+ window, accept images -->
    <Model match="llama-4*" supportsImages="true" reasoning="false" maxTokens="16384" contextLength="131072"
           requireToolInStateMachine="true" />
    <Model match="llama4*" supportsImages="true" reasoning="false" maxTokens="16384" contextLength="131072"
           requireToolInStateMachine="true" />
    <!-- Llama 3.1 / 3.3: 131K window, text only -->
    <Model match="llama-3*" supportsImages="false" reasoning="false" maxTokens="16384" contextLength="131072"
           requireToolInStateMachine="true" />
    <Model match="llama3*" supportsImages="false" reasoning="false" maxTokens="16384" contextLength="131072"
           requireToolInStateMachine="true" />

    <!-- ===== Mistral =====
         Reasoning is left off: with reasoning on, Mistral returns the message content as a list of
         chunks, rather than a string. -->
    <Model match="devstral*" supportsImages="false" reasoning="false" contextLength="131072" requireToolInStateMachine="true" />
    <Model match="codestral*" supportsImages="false" reasoning="false" contextLength="131072" requireToolInStateMachine="true" />
    <Model match="mistral-*" supportsImages="true" reasoning="false" contextLength="131072" requireToolInStateMachine="true" />
    <Model match="ministral*" supportsImages="true" reasoning="false" contextLength="131072" requireToolInStateMachine="true" />

    <!-- ===== Qwen (open weight, often run locally) ===== -->
    <Model match="qwen*coder*" supportsImages="false" reasoning="false" requireToolInStateMachine="true" />
    <Model match="qwen3*" supportsImages="false" reasoning="high" requireToolInStateMachine="true" />
    <Model match="qwq*" supportsImages="false" reasoning="high" requireToolInStateMachine="true" />


    <!-- ===== Other vendors' flash-tier models =====
         Reasoning models, usually reached through OpenRouter.  "true" turns reasoning on without
         naming a level (sent as OpenRouter's reasoning.enabled), which works whether or not the
         model has effort levels.  Values from "Fetch models" fill in the rest. -->
    <Model match="*flash*" reasoning="true" />


    <!-- ===== Provider-specific overrides =====
         These only override the fields they give, of the general entry above. -->
    <!-- Ask Sage caps output lower than the model vendors do -->
    <Model match="*gemini*" endpoint="*asksage*" maxTokens="8192" />
    <Model match="*gpt-oss*" endpoint="*asksage*" maxTokens="8192" />
    <Model match="grok-*" endpoint="*asksage*" maxTokens="16384" />
    <Model match="gpt-4.1-nano*" endpoint="*asksage*" maxTokens="16384" />
    <!-- At OpenAI itself, these models can only use tools through the Responses API -->
    <Model match="gpt-*-pro*" endpoint="*api.openai.com*" requiresFormat="openai_responses" />
    <Model match="gpt-6-astra*" endpoint="*api.openai.com*" requiresFormat="openai_responses" />
    <Model match="gpt-6.1-sol*" endpoint="*api.openai.com*" requiresFormat="openai_responses" />
  </ModelDefaults>
</LlmModelPresets>
