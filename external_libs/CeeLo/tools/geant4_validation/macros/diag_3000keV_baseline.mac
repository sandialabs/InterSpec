# Diagnostic: Config 1 baseline at 3000 keV
# Source at (0, 0, -10) cm — same as run_1_3000keV.mac
# No processes disabled — full G4 physics

/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 0.000000 0.000000 -10.000000 cm
/gps/ang/type iso
/gps/ene/type Mono
/gps/ene/mono 3.000000 MeV

/run/beamOn 16000000
