# Diagnostic: Config 1 at 662 keV — eBrem + MSC both disabled
# Closest to deterministic CSDA (pure ionization stopping)
# Should give FEP closest to our code if hypothesis is correct

/process/inactivate eBrem
/process/inactivate msc

/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 0.000000 0.000000 -10.000000 cm
/gps/ang/type iso
/gps/ene/type Mono
/gps/ene/mono 0.662000 MeV

/run/beamOn 500000
