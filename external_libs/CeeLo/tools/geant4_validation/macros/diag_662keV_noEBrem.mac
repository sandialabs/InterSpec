# Diagnostic: Config 1 at 662 keV — electron bremsstrahlung disabled
# Tests effect of electron brems on FEP peak shape

/process/inactivate eBrem

/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 0.000000 0.000000 -10.000000 cm
/gps/ang/type iso
/gps/ene/type Mono
/gps/ene/mono 0.662000 MeV

/run/beamOn 500000
