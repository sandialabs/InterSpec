{
  "_comment": [
    "Becomes the shipped app/package.json (see target/electron/CMakeLists.txt).",
    "Generated by CMake from package_for_running.json.in so the version cannot drift from the",
    "one in the top-level CMakeLists.txt - this value ends up as the .deb/.rpm/AppImage version.",
    "Note there are deliberately no `dependencies`: electron-builder treats an app's dependencies",
    "as production modules to bundle, and Electron itself is provided by the runtime."
  ],
  "name": "InterSpec",
  "version": "@INTERSPEC_VERSION@",
  "//desktopName": "Electron uses this as its Linux app_id / WM_CLASS.  Keeping it equal to the installed .desktop filename (see linux.syncDesktopName in electron-builder.js) is what lets desktop environments associate running windows with the launcher, so the correct icon and name show in the dock and alt-tab.",
  "desktopName": "interspec.desktop",
  "description": "Application for interactive gamma spectroscopy",
  "homepage": "https://github.com/sandialabs/InterSpec",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "author": {
    "name": "William Johnson",
    "email": "wcjohns@sandia.gov"
  },
  "license": "LGPL-2.1-only",
  "dependencies": {}
}
