{
  "name": "InterSpecAddOn",
  "version": "1.0.14",
  "description": "Application for interactive gamma spectroscopy",
  "homepage": "https://github.com/sandialabs/InterSpec",
  "main": "main.js",
  "repository": {
    "url": "https://github.com/sandialabs/InterSpec",
    "type": "git"
  },
  "comments": {
    "packaging": "Packaging is configured in electron-builder.js.  The `package-*` scripts below expect the CMake app directory to already exist - build it first with `cmake-js ... --target install` (see README.md).  Released Windows builds come from target/wxWidgets and released macOS builds from target/osx, so package-win/package-mac are development conveniences, not release paths."
  },
  "scripts": {
    "install": "cmake-js compile",
    "start": "electron ./build_macOS/app/",
    "package-mac": "electron-builder --mac -c.directories.app=./build_macos/app",
    "package-win": "electron-builder --win -c.directories.app=./build_win/app",
    "package-linux": "electron-builder --linux -c.directories.app=./build_linux/app",
    "package-manylinux": "electron-builder --linux -c.directories.app=./build_manylinux_electron/app"
  },
  "author": {
    "name": "William Johnson",
    "email": "wcjohns@sandia.gov"
  },
  "license": "LGPL-2.1-only",
  "dependencies": {},
  "devDependencies": {
    "cmake-js": "^7.0.0",
    "node-api-headers": "^1.3.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3",
    "node-addon-api": "^6.1.0"
  },
  "binary": {
    "napi_versions": [
      6
    ]
  }
}
